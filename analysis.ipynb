# Ячейка 1: Инициализация
from pyspark.sql import SparkSession
from pyspark.sql.functions import sum, avg, col, count, desc

spark = SparkSession.builder \
    .appName("SalesAnalysis") \
    .config("spark.sql.shuffle.partitions", "4") \
    .getOrCreate()

# Ячейка 2: Загрузка данных
df = spark.read.csv("data/sales.csv", header=True, inferSchema=True)
df.printSchema()
df.show(5)

# Ячейка 3: Очистка
df_clean = df.dropna().dropDuplicates()
print(f"Строк до: {df.count()}, после: {df_clean.count()}")

# Ячейка 4: Агрегация по регионам
region_stats = df_clean.groupBy("region") \
    .agg(
        sum("amount").alias("total_sales"),
        avg("amount").alias("avg_sale"),
        count("order_id").alias("orders_count")
    ) \
    .orderBy(desc("total_sales"))
region_stats.show()

# Ячейка 5: Агрегация по месяцам
month_stats = df_clean.groupBy("month") \
    .agg(sum("amount").alias("total")) \
    .orderBy("month")
month_stats.show()

# Ячейка 6: Топ-10 товаров
top_products = df_clean.groupBy("product") \
    .agg(sum("amount").alias("revenue")) \
    .orderBy(desc("revenue")) \
    .limit(10)
top_products.show()

# Ячейка 7: Экспорт результата
region_stats.toPandas().to_csv("output/region_stats.csv", index=False)
